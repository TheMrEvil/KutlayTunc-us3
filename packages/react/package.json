{
  "name": "@kutlaytunc/us3-react",
  "version": "0.1.0",
  "type": "module",
  "description": "React Three Fiber bindings for us3: <AnimatedCharacter> + a hook per runtime — useBehaviorTree, usePerceptionSystem, useNavAgent, useEnvQuery, useMontage, useLookAt — plus debug visualizers.",
  "license": "MIT",
  "author": "KutlayTunc",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/KutlayTunc/us3.git",
    "directory": "packages/react"
  },
  "keywords": ["us3", "react-three-fiber", "r3f", "three", "game-ai", "behaviour-tree", "animation", "blendspace", "drei"],
  "sideEffects": false,
  "publishConfig": { "access": "public" },
  "files": ["dist"],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": { "types": "./dist/index.d.ts", "import": "./dist/index.js" }
  },
  "scripts": {
    "build": "vite build --mode lib && pnpm build:types",
    "build:types": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kutlaytunc/us3-ai": "workspace:*",
    "@kutlaytunc/us3-anim": "workspace:*",
    "@kutlaytunc/us3-core": "workspace:*"
  },
  "peerDependencies": {
    "@react-three/drei": ">=10.0.0",
    "@react-three/fiber": ">=9.0.0",
    "react": ">=18.0.0",
    "three": ">=0.159.0"
  },
  "devDependencies": {
    "@react-three/drei": "^10.7.4",
    "@react-three/fiber": "^9.3.0",
    "@types/react": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "@types/three": "^0.184.0",
    "react": "^19.1.0",
    "three": "^0.184.0",
    "typescript": "^5.7.0",
    "vite": "^7.1.0"
  }
}
